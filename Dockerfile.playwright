# Fallback Railway build for BGP with Chromium baked in, for the Edozo token
# refresher (server/edozo-refresh.ts). The default build is Nixpacks
# (see railway.toml + nixpacks.toml); use this ONLY if Nix's chromium won't
# launch under Playwright on Railway.
#
# To activate:
#   1. In railway.toml set:  builder = "dockerfile"
#      and:                   dockerfilePath = "Dockerfile.playwright"
#      and remove the buildCommand line (this Dockerfile runs the build).
#   2. Leave the deploy startCommand as "npm start".
#   3. Redeploy.
#
# Node 22 matches .nvmrc. `playwright install --with-deps chromium` pulls the
# Chromium build Playwright expects plus its system libraries, so leave
# EDOZO_CHROMIUM_PATH UNSET — resolveChromiumPath() finds nothing on PATH and
# Playwright uses its own managed browser.

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

# poppler-utils mirrors the Nixpacks setup (pdfimages / pdftoppm for the
# property-pathway brochure sweeps); ca-certificates for outbound TLS.
RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Install all deps first (build needs devDeps: tsx, esbuild, vite).
COPY package*.json ./
RUN npm ci

# Chromium + its system libraries for the headless-login refresher.
RUN npx playwright install --with-deps chromium

# App source + production build (produces dist/index.cjs and dist/public).
COPY . .
RUN npm run build

CMD ["node", "dist/index.cjs"]
